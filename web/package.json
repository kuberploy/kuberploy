{
  "name": "@kuberploy/web",
  "private": true,
  "version": "0.1.0-rc.20",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "26.7.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && pnpm build:api-docs && node scripts/test-api-docs.mjs --built dist/docs",
    "build:api-docs": "node scripts/build-api-docs.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && pnpm test:api-docs",
    "test:api-docs": "node scripts/test-api-docs.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "monaco-editor": "0.56.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "shadcn": "4.16.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "swagger-ui-dist": "5.32.12",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
