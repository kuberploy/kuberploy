{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "testRun", "repositoryName", "persistence"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "pullPolicy"],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^[^\\s]+(?:@sha256:[a-f0-9]{64}|:[A-Za-z0-9][A-Za-z0-9._-]{0,127})$"
        },
        "pullPolicy": { "enum": ["Never", "IfNotPresent"] }
      }
    },
    "testRun": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,19}$"
    },
    "repositoryName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,62}\\.git$"
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageClassName", "size"],
      "properties": {
        "storageClassName": { "type": "string", "minLength": 1, "maxLength": 63 },
        "size": { "type": "string", "pattern": "^[1-9][0-9]*(?:Mi|Gi)$" }
      }
    }
  }
}
