{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["secretFoundation", "sealedSecrets"],
  "properties": {
    "global": {"type": "object"},
    "secretFoundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller", "namespace", "networkPolicy", "keyRecovery"],
      "properties": {
        "controller": {
          "type": "object",
          "additionalProperties": false,
          "required": ["managed", "adoptExisting", "capabilitiesConfirmed"],
          "properties": {
            "managed": {"type": "boolean"},
            "adoptExisting": {"type": "boolean"},
            "capabilitiesConfirmed": {"type": "boolean"}
          }
        },
        "namespace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["create"],
          "properties": {"create": {"type": "boolean"}}
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "kubeAPIServerCIDRs", "controlPlaneNamespace", "monitoringNamespace"],
          "properties": {
            "enabled": {"const": true},
            "kubeAPIServerCIDRs": {"$ref": "#/$defs/cidrs"},
            "controlPlaneNamespace": {"const": "kuberploy-system"},
            "monitoringNamespace": {"const": "kuberploy-monitoring"}
          }
        },
        "keyRecovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "keyPrefix"],
          "properties": {
            "required": {"const": true},
            "keyPrefix": {"const": "kuberploy-sealed-secrets-key"}
          }
        }
      }
    },
    "sealedSecrets": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "cidrs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}
    }
  }
}
