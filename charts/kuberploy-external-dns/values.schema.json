{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["foundation", "externaldns"],
  "properties": {
    "global": {"type": "object"},
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "externalDNS", "allowDestructiveSync", "networkPolicy"],
      "properties": {
        "enabled": {"type": "boolean"},
        "externalDNS": {
          "type": "object",
          "additionalProperties": false,
          "required": ["managed", "adoptExisting", "filtersConfirmed", "identity"],
          "properties": {
            "managed": {"type": "boolean"},
            "adoptExisting": {"type": "boolean"},
            "filtersConfirmed": {"type": "boolean"},
            "identity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["providerKind", "credentialSecretRef", "providerConfigRef", "egressConfigRef"],
              "properties": {
                "providerKind": {"type": "string", "enum": ["", "aws", "azure", "cloudflare", "google", "rfc2136"]},
                "credentialSecretRef": {"type": "string", "maxLength": 253, "pattern": "^(?:|[a-z0-9](?:[-a-z0-9.]{0,251}[a-z0-9])?)$"},
                "providerConfigRef": {"type": "string", "maxLength": 253, "pattern": "^(?:|[a-z0-9](?:[-a-z0-9.]{0,251}[a-z0-9])?)$"},
                "egressConfigRef": {"type": "string", "maxLength": 253, "pattern": "^(?:|[a-z0-9](?:[-a-z0-9.]{0,251}[a-z0-9])?)$"}
              }
            }
          }
        },
        "allowDestructiveSync": {"type": "boolean"},
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "kubeAPIServerCIDRs", "providerEgressCIDRs", "providerEgressPorts"],
          "properties": {
            "enabled": {"type": "boolean"},
            "kubeAPIServerCIDRs": {"$ref": "#/$defs/cidrList"},
            "providerEgressCIDRs": {"$ref": "#/$defs/cidrList"},
            "providerEgressPorts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {"type": "integer", "enum": [80, 443]}
            }
          }
        }
      }
    },
    "externaldns": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "txtPrefix": {"const": "a-"},
        "txtOwnerId": {"type": ["string", "null"], "maxLength": 128},
        "domainFilters": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9](?:[-a-z0-9.]*[a-z0-9])?$"}
        },
        "labelFilter": {
          "type": ["string", "null"],
          "maxLength": 128,
          "pattern": "^$|^kuberploy\\.io/dns-integration=[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"
        },
        "provider": {
          "type": "object",
          "required": ["name"],
          "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9][a-z0-9-]*$"}}
        },
        "env": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "valueFrom"],
            "properties": {
              "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "maxLength": 253},
              "valueFrom": {
                "type": "object",
                "additionalProperties": false,
                "required": ["secretKeyRef"],
                "properties": {
                  "secretKeyRef": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "key"],
                    "properties": {
                      "name": {"$ref": "#/$defs/dnsLabel"},
                      "key": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9._-]+$"},
                      "optional": {"const": false}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "dnsLabel": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$"},
    "cidrList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"}
    }
  }
}
