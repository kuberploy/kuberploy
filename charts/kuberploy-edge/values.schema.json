{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["edge", "traefik"],
  "properties": {
    "global": {"type": "object"},
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "traefik", "networkPolicy"],
      "properties": {
        "namespace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["create"],
          "properties": {"create": {"type": "boolean"}}
        },
        "traefik": {
          "type": "object",
          "additionalProperties": false,
          "required": ["managed", "adoptExisting", "crdProviderConfirmed"],
          "properties": {
            "managed": {"type": "boolean"},
            "adoptExisting": {"type": "boolean"},
            "crdProviderConfirmed": {"type": "boolean"},
            "sslip": {"$ref": "#/$defs/sslipProfile"}
          }
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "kubeAPIServerCIDRs", "publicIngressCIDRs"],
          "properties": {
            "enabled": {"type": "boolean"},
            "kubeAPIServerCIDRs": {"$ref": "#/$defs/cidrList"},
            "publicIngressCIDRs": {"$ref": "#/$defs/cidrList"}
          }
        }
      }
    },
    "traefik": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "service": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "additionalServices": {"type": "object", "maxProperties": 0}
          }
        }
      }
    }
  },
  "$defs": {
    "sslipProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["auto-first-ip", "verified-static-ip"]},
        "staticPublicIPv4": {
          "type": "string",
          "format": "ipv4",
          "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]?|0)\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]?|0)$"
        }
      },
      "oneOf": [
        {
          "properties": {"mode": {"const": "auto-first-ip"}}
        },
        {
          "properties": {"mode": {"const": "verified-static-ip"}},
          "required": ["staticPublicIPv4"]
        }
      ]
    },
    "cidrList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 64,
        "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
      }
    }
  }
}
