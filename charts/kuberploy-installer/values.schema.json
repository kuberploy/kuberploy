{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["bootstrap", "source", "applications", "cluster", "publicEndpoint", "integrations", "components", "argoCD", "bootstrapvalkey"],
  "properties": {
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valkey", "argoCD", "controlPlaneToken"],
      "properties": {
        "valkey": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {"enabled": {"type": "boolean"}}
        },
        "argoCD": { "$ref": "#/$defs/argoInstallationMode" },
        "controlPlaneToken": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "kubeAPIServerCIDRs"],
          "properties": {
            "mode": { "enum": ["disabled", "generated", "precreated"] },
            "kubeAPIServerCIDRs": {
              "type": "array", "maxItems": 16, "uniqueItems": true,
              "items": { "type": "string", "pattern": "^(?:(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/32|[0-9A-Fa-f:]+/128)$" }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chartRepository", "valuesRepository", "valuesRevision"],
      "properties": {
        "chartRepository": { "const": "ghcr.io/kuberploy/charts" },
        "valuesRepository": { "type": "string", "maxLength": 240 },
        "valuesRevision": {
          "type": "string",
          "pattern": "^(?:|v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?)$",
          "maxLength": 64
        }
      }
    },
    "applications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automated", "prune", "selfHeal"],
      "properties": {
        "automated": { "type": "boolean" },
        "prune": { "type": "boolean" },
        "selfHeal": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "automated": { "const": false } }, "required": ["automated"] },
          "then": { "properties": { "prune": { "const": false }, "selfHeal": { "const": false } } }
        }
      ]
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kubeAPIServerCIDRs"],
      "properties": {
        "kubeAPIServerCIDRs": {
          "type": "array", "maxItems": 16, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?:(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/32|[0-9A-Fa-f:]+/128)$" }
        }
      }
    },
    "publicEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "hostname", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "hostname": {
          "type": "string", "maxLength": 253,
          "pattern": "^(?:|[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)+)$"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "secretName", "clusterIssuerName", "accountEmail"],
          "properties": {
            "enabled": { "type": "boolean" },
            "secretName": {
              "type": "string", "maxLength": 63,
              "pattern": "^(?:|[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)$"
            },
            "clusterIssuerName": {
              "type": "string", "maxLength": 63,
              "pattern": "^(?:|[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)$"
            },
            "accountEmail": {
              "type": "string", "maxLength": 254,
              "pattern": "^(?:|[^@\\s]+@[^@\\s]+\\.[^@\\s]+)$"
            }
          }
        }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github"],
      "properties": {
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "appID", "clientID", "appSlug", "secretName", "clusterID", "controlPlaneEgressCIDRs", "sourceEgressCIDRs", "registryEgressCIDRs"],
          "properties": {
            "enabled": { "type": "boolean" },
            "appID": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
            "clientID": { "type": "string", "maxLength": 128 },
            "appSlug": { "type": "string", "maxLength": 100 },
            "secretName": { "$ref": "#/$defs/optionalDNSLabel" },
            "clusterID": { "type": "string", "pattern": "^(?:|[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$" },
            "controlPlaneEgressCIDRs": { "$ref": "#/$defs/hostCIDRs" },
            "sourceEgressCIDRs": { "$ref": "#/$defs/hostCIDRs" },
            "registryEgressCIDRs": { "$ref": "#/$defs/hostCIDRs" }
          },
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
              "then": { "properties": { "appID": { "const": 0 }, "clientID": { "const": "" }, "appSlug": { "const": "" }, "secretName": { "const": "" }, "clusterID": { "const": "" }, "controlPlaneEgressCIDRs": { "maxItems": 0 }, "sourceEgressCIDRs": { "maxItems": 0 }, "registryEgressCIDRs": { "maxItems": 0 } } }
            },
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": { "properties": { "appID": { "minimum": 1 }, "clientID": { "minLength": 6 }, "appSlug": { "minLength": 1 }, "secretName": { "minLength": 1 }, "clusterID": { "minLength": 36 }, "controlPlaneEgressCIDRs": { "minItems": 1 }, "sourceEgressCIDRs": { "minItems": 1 }, "registryEgressCIDRs": { "minItems": 1 } } }
            }
          ]
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlPlane", "postgresql", "valkey", "edge", "certManager", "externalDNS", "externalSecrets", "sealedSecrets", "monitoring", "builder", "registry"],
      "properties": {
        "controlPlane": { "$ref": "#/$defs/managedOnlyComponent" },
        "postgresql": { "$ref": "#/$defs/adoptableComponent" },
        "valkey": { "$ref": "#/$defs/adoptableComponent" },
        "edge": { "$ref": "#/$defs/adoptableComponent" },
        "certManager": { "$ref": "#/$defs/adoptableComponent" },
        "externalDNS": { "$ref": "#/$defs/adoptableComponent" },
        "externalSecrets": { "$ref": "#/$defs/adoptableComponent" },
        "sealedSecrets": { "$ref": "#/$defs/adoptableComponent" },
        "monitoring": { "$ref": "#/$defs/managedOnlyComponent" },
        "builder": { "$ref": "#/$defs/managedOnlyComponent" },
        "registry": { "$ref": "#/$defs/managedOnlyComponent" }
      }
    },
    "argoCD": {
      "type": "object",
      "description": "Values passed unchanged to the pinned kuberploy-argocd bootstrap dependency. Its own strict schema remains authoritative."
    },
    "bootstrapvalkey": {
      "type": "object",
      "description": "Values passed to the pinned installer-owned Valkey bootstrap dependency."
    }
  },
  "$defs": {
    "optionalDNSLabel": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^(?:|[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)$"
    },
    "hostCIDRs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?:(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/32|[0-9A-Fa-f:]+/128)$" }
    },
    "argoInstallationMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mode", "managedPrerequisitesConfirmed"],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["disabled", "managed", "adopted"] },
        "managedPrerequisitesConfirmed": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
          "then": {
            "properties": {
              "mode": { "const": "disabled" },
              "managedPrerequisitesConfirmed": { "const": false }
            }
          },
          "else": { "properties": { "mode": { "enum": ["managed", "adopted"] } } }
        },
        {
          "if": { "properties": { "mode": { "const": "managed" } }, "required": ["mode"] },
          "then": { "properties": { "managedPrerequisitesConfirmed": { "const": true } } },
          "else": { "properties": { "managedPrerequisitesConfirmed": { "const": false } } }
        }
      ]
    },
    "componentBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mode", "adoptionConfirmed", "expectedPackageVersion", "valueFiles"],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["disabled", "managed", "adopted"] },
        "adoptionConfirmed": { "type": "boolean" },
        "expectedPackageVersion": { "type": "string", "maxLength": 32 },
        "valueFiles": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^examples/installer/[a-z0-9][a-z0-9._/-]{0,180}\\.ya?ml$"
          }
        }
      }
    },
    "managedOnlyComponent": {
      "allOf": [
        { "$ref": "#/$defs/componentBase" },
        {
          "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
          "then": {
            "properties": {
              "mode": { "const": "disabled" },
              "adoptionConfirmed": { "const": false },
              "expectedPackageVersion": { "const": "" },
              "valueFiles": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "mode": { "const": "managed" },
              "adoptionConfirmed": { "const": false },
              "expectedPackageVersion": { "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-rc\\.[0-9]+)?$" }
            }
          }
        }
      ]
    },
    "adoptableComponent": {
      "allOf": [
        { "$ref": "#/$defs/componentBase" },
        {
          "if": { "properties": { "enabled": { "const": false } }, "required": ["enabled"] },
          "then": {
            "properties": {
              "mode": { "const": "disabled" },
              "adoptionConfirmed": { "const": false },
              "expectedPackageVersion": { "const": "" },
              "valueFiles": { "maxItems": 0 }
            }
          },
          "else": {
            "properties": {
              "expectedPackageVersion": { "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-rc\\.[0-9]+)?$" }
            },
            "allOf": [
              {
                "if": { "properties": { "mode": { "const": "adopted" } }, "required": ["mode"] },
                "then": { "properties": { "adoptionConfirmed": { "const": true } } },
                "else": {
                  "properties": {
                    "mode": { "const": "managed" },
                    "adoptionConfirmed": { "const": false }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
