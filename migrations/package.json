{
  "name": "@kuberploy/database-migrations",
  "version": "0.1.0",
  "private": true,
  "description": "Migration-only Prisma runtime for Kuberploy PostgreSQL",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "deploy": "prisma migrate deploy --config prisma.config.ts",
    "status": "prisma migrate status --config prisma.config.ts",
    "format": "prisma format --schema prisma/schema.prisma",
    "pull": "prisma db pull --force --config prisma.config.ts",
    "pull:print": "prisma db pull --print --config prisma.config.ts",
    "check:drift": "node check-schema-drift.mjs",
    "validate": "prisma validate --config prisma.config.ts"
  },
  "dependencies": {
    "postgres": "3.4.9",
    "prisma": "7.9.1"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true
  }
}
